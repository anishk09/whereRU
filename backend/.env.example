# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SECRET_KEY=

# demo  = no AI calls
# local = on-device OpenCV room matching (no API key, works offline)
# gemini = Google Gemini (needs GEMINI_API_KEY with a working quota)
AI_MODE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# console = sign-in codes print in the Flask terminal; smtp = real email
AUTH_DELIVERY=console
# Development only: allows the frontend "Skip for demo" button to sign in without a code.
DEMO_LOGIN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Extra frontend origins allowed to call the API (comma separated). Not needed with the Vite proxy.
ALLOWED_ORIGINS=
